# OpenAI (LLM + embeddings untuk RAG engine)
OPENAI_API_KEY=your-openai-api-key-here

# Model overrides (opsional)
AEGIS_LLM_MODEL=gpt-4o
AEGIS_EMBED_MODEL=text-embedding-3-small

# Qdrant: kosongkan untuk mode in-memory, atau isi URL server, mis. http://localhost:6333
QDRANT_URL=
QDRANT_COLLECTION=financial_reports

# Finnhub (opsional, belum wajib — yfinance dipakai sebagai sumber default)
FINNHUB_API_KEY=

# Dashboard -> lokasi backend FastAPI
AEGIS_API_URL=http://localhost:8000
